//
// VR mode, the game's interface (hearts, buttons, texts). Its draws are sent to an image of ours instead of the
// game's picture (hook V6), so that the headset can show it on a panel of its own. Here, at the end of the frame:
// the interface for the panel (8 bits, sRGB), and the interface laid back over the game's picture, as the game would
// have drawn it (the window on the desk then shows the whole game).
#version 460
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D ui;      // linear light, colour already times its alpha
layout(binding = 1, r11f_g11f_b10f) uniform image2D pic;
layout(binding = 2, rgba8) uniform writeonly image2D panel;
layout(push_constant) uniform PC {
    vec2 size;
    uint flags;      // 1 laid back over the picture; 2 the panel's image written; 4 a box is left out of the panel
    vec4 hole;       // that box, in pixels: the game's own sight while it aims (ours is drawn in the eyes, rt_vr_warp.comp)
} pc;

vec3 srgb(vec3 c) {
    c = clamp(c, 0.0, 1.0);
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
}

void main() {
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(pc.size.x) || p.y >= int(pc.size.y)) return;
    const vec4 o = texelFetch(ui, p, 0);
    const float a = clamp(o.a, 0.0, 1.0);
    const bool out_of_panel = (pc.flags & 4u) != 0u && float(p.x) >= pc.hole.x && float(p.x) < pc.hole.z && float(p.y) >= pc.hole.y && float(p.y) < pc.hole.w;
    if ((pc.flags & 2u) != 0u) imageStore(panel, p, out_of_panel ? vec4(0.0) : vec4(srgb(o.rgb), a));
    if ((pc.flags & 1u) != 0u && (a > 0.0 || o.r + o.g + o.b > 0.0)) {
        const vec3 c = imageLoad(pic, p).rgb;
        imageStore(pic, p, vec4(o.rgb + c * (1.0 - a), 1.0));
    }
}
